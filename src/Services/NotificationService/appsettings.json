{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Information"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "meeting-platform",
    "Audience": "meeting-platform-users",
    "ExpirationHours": "24"
  },
  "RabbitMq": {
    "Enabled": false,
    "ServiceName": "notification-service",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "samvaad",
    "Password": "",
    "VirtualHost": "/",
    "ExchangeName": "samvaad.events",
    "DeadLetterExchangeName": "samvaad.events.dead",
    "ConsumerPrefetchCount": 20,
    "UseQuorumQueues": true,
    "DeliveryLimit": 5,
    "EnablePublisherConfirms": true,
    "PublisherConfirmTimeoutSeconds": 5,
    "RequireRoutableMessages": true
  },
  "Security": {
    "AllowedOrigins": []
  },
  "AllowedHosts": "localhost"
}
