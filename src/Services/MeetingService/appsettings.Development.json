{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=meeting_meetings;Username=postgres;Password=postgres123"
  },
  "Redis": {
    "Enabled": true,
    "ConnectionString": "localhost:6379,abortConnect=false",
    "InstanceName": "samvaad-meeting",
    "DefaultTtlSeconds": 300
  },
  "JwtSettings": {
    "SecretKey": "local-development-only-samvaad-shared-jwt-secret-please-override-in-production",
