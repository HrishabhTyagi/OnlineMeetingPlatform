  "Email": {
    "Enabled": true,
    "Host": "localhost",
    "Port": 1025,
    "UseSsl": false,
    "Username": "",
    "Password": "",
    "FromEmail": "no-reply@samvaad.local",
    "FromName": "Samvaad",
    "LicenseRequestsToEmail": "sales@samvaad.local"
  },
  "RabbitMq": {
    "Enabled": true,
    "ServiceName": "meeting-service",
    "HostName": "localhost",
    "Port": 5672,
    "UserName": "samvaad",
    "Password": "samvaad123",
    "VirtualHost": "/",
    "ExchangeName": "samvaad.events",
    "DeadLetterExchangeName": "samvaad.events.dead",
    "ConsumerPrefetchCount": 10,
    "UseQuorumQueues": true,
    "DeliveryLimit": 5,
    "EnablePublisherConfirms": true,
    "PublisherConfirmTimeoutSeconds": 5,
