    },
    "Outlook": {
      "ClientId": "",
      "ClientSecret": "",
      "Tenant": "common"
    }
  },
  "Security": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:5174",
      "http://localhost:3000"
    ],
    "MaxRequestBodyBytes": 750000000,
    "AllowPublicRecordings": true
  }
